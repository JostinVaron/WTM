#!/data/data/com.termux/files/usr/bin/bash
# DeX wizard: unico punto de entrada, a prueba de reboot.
set -uo pipefail
export PATH=/data/data/com.termux/files/usr/bin:/system/bin:/system/xbin
export HOME=/data/data/com.termux/files/home
export PREFIX=/data/data/com.termux/files/usr

ADB="$PREFIX/bin/adb"
LOG="$PREFIX/tmp/rd-wizard.log"
ENVF="$HOME/.config/wtm/server.env"
# PORT: del server.env si existe (coherente con start-dex.sh y el watchdog);
# fallback 8443 (default del runtime).
PORT=8443
if [ -f "$ENVF" ]; then
    PORT=$(sed -n 's/^PORT=//p' "$ENVF" | head -n1 | tr -d '\r')
    [ -z "$PORT" ] && PORT=8443
fi
mkdir -p "$PREFIX/tmp"
exec >>"$LOG" 2>&1

NONINTERACTIVE="${WTM_WIZARD_NONINTERACTIVE:-0}"
log(){ printf '[wizard] %s %s\n' "$(date '+%F %T')" "$*"; }
ui(){ log "$1"; [ "$NONINTERACTIVE" = "1" ] && return 0; timeout 4 termux-toast -g top "$1" >/dev/null 2>&1 || true; }
fail(){ ui "DeX FALLO: $1"; [ "$NONINTERACTIVE" = "1" ] || termux-notification -t "DeX: fallo" --content "$1 — log: rd-wizard.log" >/dev/null 2>&1 || true; log "FALLO: $1"; exit 1; }
ash(){ "$ADB" -s 127.0.0.1:5555 shell "$1" 2>/dev/null | tr -d '\r'; }
health(){ curl -sk --max-time 3 "https://${1}:$PORT/healthz" 2>/dev/null; }
json_text(){ python3 -c 'import sys,json
try: print(json.load(sys.stdin).get("text","").strip())
except Exception: print("")'; }

# Tablet: se busca por modelo (SM-P613), nunca se asume el serial.
tablet_serial(){
  local s model
  for s in $("$ADB" devices 2>/dev/null | tr -d '\r' | awk 'NR>1 && $2=="device"{print $1}'); do
    [ "$s" = "127.0.0.1:5555" ] && continue
    model=$("$ADB" -s "$s" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
    case "$model" in
      "${WTM_TABLET_MODEL:-SM-P613}"*) printf '%s' "$s"; return 0 ;;
    esac
  done
  return 1
}

# Actualiza la URL guardada del viewer (run-as, APK debug) y lo lanza.
# Si el ADB de la tablet no esta disponible, no es un fallo: la app queda
# con su URL anterior y el wizard lo registra.
tablet_launch(){
  local tab="$1" ip="$2" pkg=ai.ashna.wtmviewer tmp="$PREFIX/tmp/wtm-tablet-prefs.xml"
  if "$ADB" -s "$tab" shell run-as "$pkg" cat "/data/data/$pkg/shared_prefs/wtm.xml" 2>/dev/null | tr -d '\r' > "$tmp" && [ -s "$tmp" ]; then
    sed -i "s#<string name=\"base_url\">[^<]*</string>#<string name=\"base_url\">https://$ip:$PORT</string>#" "$tmp" || true
    "$ADB" -s "$tab" shell am force-stop "$pkg" >/dev/null 2>&1 || true
    if "$ADB" -s "$tab" shell "run-as $pkg sh -c 'cat > /data/data/$pkg/shared_prefs/wtm.xml'" < "$tmp" >/dev/null 2>&1; then
      log "tablet: base_url -> https://$ip:$PORT"
    else
      log "tablet: no pude escribir prefs; la app conserva su URL."
    fi
    rm -f "$tmp"
  else
    rm -f "$tmp"
    log "tablet: sin prefs accesibles (run-as); no toco la URL."
  fi
  if "$ADB" -s "$tab" shell am start -n "$pkg/.MainActivity" >/dev/null 2>&1; then
    log "tablet: viewer lanzado en $tab"
  else
    log "tablet: no pude lanzar el viewer; abrelo a mano."
  fi
}

log "=== wizard iniciado ==="
"$ADB" start-server >/dev/null 2>&1 || true

ui "DeX: verificando conexion adb (1/6)..."
adb_ok=0
for _ in 1 2 3; do
  "$ADB" connect 127.0.0.1:5555 >/dev/null 2>&1 || true
  if "$ADB" devices 2>/dev/null | tr -d '\r' | grep -q '127.0.0.1:5555[[:space:]]*device'; then adb_ok=1; break; fi
  sleep 2
done

if [ "$adb_ok" -ne 1 ]; then
  log "adb 5555 caido -> rutina C guiada."
  termux-dialog confirm -t "DeX: reinicio detectado" -i "En el telefono: 1) Conectalo al Wi-Fi de casa  2) Ajustes > Opciones de desarrollador > Depuracion inalambrica > Activar.  Toca SI cuando este activo." >/dev/null 2>&1 || true
  DEV=""
  for intento in 1 2 3; do
    ans=$(termux-dialog text -t "DeX: IP y puerto" -i "Abre Depuracion inalambrica, mira 'Direccion IP y puerto' y escribelo aqui (ej 192.0.2.10:37521)" 2>/dev/null || true)
    DEV=$(printf '%s' "$ans" | json_text)
    log "intento $intento: DEV='$DEV'"
    [ -z "$DEV" ] && continue
    "$ADB" connect "$DEV" >/dev/null 2>&1 || true
    sleep 2
    if "$ADB" devices 2>/dev/null | tr -d '\r' | grep -q "${DEV}[[:space:]]*device"; then break; fi
    DEV=""
  done
  [ -z "$DEV" ] && fail "No se pudo conectar adb inalambrico. Vuelve a tocar el widget."
  "$ADB" -s "$DEV" tcpip 5555 >/dev/null 2>&1 || true
  sleep 3
  "$ADB" disconnect "$DEV" >/dev/null 2>&1 || true
fi

adb_ok=0
for _ in 1 2 3 4 5; do
  "$ADB" connect 127.0.0.1:5555 >/dev/null 2>&1 || true
  if "$ADB" devices 2>/dev/null | tr -d '\r' | grep -q '127.0.0.1:5555[[:space:]]*device'; then adb_ok=1; break; fi
  sleep 2
done
[ "$adb_ok" -ne 1 ] && fail "adb sigue caido tras la rutina C."
log "adb 5555 OK."

ui "DeX: verificando hotspot (3/6)..."
IP=""
for _ in $(seq 1 12); do
  IP=$(ash "ip -4 addr show swlan0" | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n1)
  [ -n "$IP" ] && break
  ui "Enciende el HOTSPOT del telefono"
  sleep 5
done
[ -z "$IP" ] && fail "Hotspot no detectado en 1 minuto."
log "hotspot OK, IP=$IP"

if [ -f "$ENVF" ]; then
  # 0.0.0.0 se respeta (sirve hotspot y router); una IP fija se actualiza.
  BIND=$(grep -m1 '^WTM_BIND_HOST=' "$ENVF" | cut -d= -f2-)
  if [ -z "$BIND" ]; then
    echo "WTM_BIND_HOST=0.0.0.0" >> "$ENVF"
  elif [ "$BIND" != "0.0.0.0" ] && [ "$BIND" != "$IP" ]; then
    sed -i "s/^WTM_BIND_HOST=.*/WTM_BIND_HOST=$IP/" "$ENVF"
  fi
  # La lista de hosts se amplia, nunca se recorta (localhost para health/tests).
  HOSTS=$(grep -m1 '^WTM_ALLOWED_HOSTS=' "$ENVF" | cut -d= -f2-)
  for h in "$IP" 127.0.0.1 localhost; do
    case ",$HOSTS," in
      *",$h,"*) : ;;
      *) HOSTS="${HOSTS:+$HOSTS,}$h" ;;
    esac
  done
  if grep -q '^WTM_ALLOWED_HOSTS=' "$ENVF"; then
    sed -i "s#^WTM_ALLOWED_HOSTS=.*#WTM_ALLOWED_HOSTS=$HOSTS#" "$ENVF"
  else
    echo "WTM_ALLOWED_HOSTS=$HOSTS" >> "$ENVF"
  fi
fi
log "server.env sincronizado a $IP"

ui "DeX: verificando tablet (5/6)..."
tablet=0
for _ in $(seq 1 12); do
  if ash "ip neigh show dev swlan0" | grep -qE '^[0-9]+\.'; then tablet=1; break; fi
  ui "Conecta la TABLET a la red Wi-Fi del telefono"
  sleep 5
done
[ "$tablet" -ne 1 ] && fail "No veo la tablet en el hotspot en 1 minuto."
log "tablet OK."

if health "$IP" | grep -q '"scrcpy_alive": *true'; then
  ui "DeX ya estaba listo"
  log "servicio ya sano; no se reinicia nada."
else
  ui "DeX: arrancando servicio (6/6)..."
  bash "$HOME/.config/wtm/bin/stop-dex.sh" >/dev/null 2>&1 || true
  sleep 2
  bash "$HOME/.config/wtm/bin/start-dex.sh" >/dev/null 2>&1 || true
  listo=0
  for _ in $(seq 1 30); do
    health "$IP" | grep -q '"scrcpy_alive": *true' && { listo=1; break; }
    sleep 2
  done
  [ "$listo" -ne 1 ] && fail "El servicio no alcanzo scrcpy_alive en 60s. Mira rd-start.log y rd-bridge.log."
fi

# Tablet: si su ADB esta conectado, actualiza base_url y lanza el viewer.
TAB=$(tablet_serial || true)
if [ -n "${TAB:-}" ]; then
  ui "DeX: actualizando viewer de la tablet..."
  tablet_launch "$TAB" "$IP"
else
  log "tablet ADB no disponible; no actualizo prefs ni lanzo la app."
fi

URL="https://$IP:$PORT"
termux-clipboard-set "$URL" >/dev/null 2>&1 || true
FP=$(health "$IP" 2>/dev/null | tr -d '\n' | grep -oE '"tls_fingerprint": *"[^"]+"' | cut -d'"' -f4 || true)
MSG="Abre WTM Viewer en la TABLET (auto-conecta a $URL)."
[ -n "$FP" ] && MSG="$MSG  Huella TLS: $FP"
if [ "$NONINTERACTIVE" != "1" ]; then
  termux-notification -t "DeX listo" --content "$MSG" >/dev/null 2>&1 || true
  termux-dialog confirm -t "DeX LISTO" -i "$MSG" >/dev/null 2>&1 || true
fi
ui "DeX listo: $MSG"
printf '[wizard] %s LISTO. Tablet: %s\n' "$(date '+%F %T')" "$URL"
